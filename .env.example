# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Supabase Authentication (Required)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic (AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
# For Supabase PostgreSQL (recommended for both development and production):
# Get this from: https://app.supabase.com/project/_/settings/database (Connection Pooling -> Transaction mode)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# For SQLite/LibSQL development (alternative option):
# DATABASE_URL="file:./db.sqlite"

# Email Provider Configuration
# Choose your email provider: mailjet (default), sendgrid, or resend
# EMAIL_PROVIDER="mailjet"

# Mailjet Configuration (default provider)
MAILJET_API_KEY="your-mailjet-api-key"
MAILJET_SECRET_KEY="your-mailjet-secret-key"
MAILJET_FROM_EMAIL="noreply@joinnewearthcollective.com"
MAILJET_FROM_NAME="New Earth Collective"

# Optional: SendGrid Configuration (if using SendGrid)
# EMAIL_PROVIDER="sendgrid"
# SENDGRID_API_KEY="your-sendgrid-api-key"
# SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
# SENDGRID_FROM_NAME="Your Name"

# Optional: Resend Configuration (if using Resend)
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="your-resend-api-key"
# RESEND_FROM_EMAIL="noreply@yourdomain.com"
# RESEND_FROM_NAME="Your Name"

# Optional: Cron Job Security
# CRON_SECRET="your-secret-key-here"

# Base URL for email templates (used for image links)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Klaviyo Configuration (Optional - for email marketing flows)
# Get from: https://www.klaviyo.com/settings/account/api-keys
KLAVIYO_API_KEY="your-klaviyo-private-api-key"
KLAVIYO_PUBLIC_KEY="your-klaviyo-public-api-key"
KLAVIYO_METRIC_ID="your-klaviyo-metric-id"

# Tracking & Analytics
# Random salt for hashing IP addresses (privacy-safe analytics)
IP_HASH_SALT="generate-a-random-string-here"

# Cookie domain for cross-subdomain tracking (e.g. ".joinnewearthcollective.com")
NEXT_PUBLIC_COOKIE_DOMAIN=".joinnewearthcollective.com"

# Base URL for email template assets (images, stylesheets)
NEXT_PUBLIC_EMAIL_ASSET_BASE_URL="https://joinnewearthcollective.com"